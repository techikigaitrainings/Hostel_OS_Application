# ---- Web app (client-safe: anon key only, never service role) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste from `supabase start` output>

# ---- Supabase local stack ----
# Local dev default, documented publicly by Supabase:
POSTGRES_PASSWORD=postgres

# ---- Server-only (edge functions / server routes). NEVER expose to client. ----
# SUPABASE_SERVICE_ROLE_KEY=<paste from `supabase start` output>

# ---- External integrations (configure when those modules are built) ----
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# WHATSAPP_BUSINESS_TOKEN=
# FCM_SERVER_KEY=
# LLM_API_KEY=
